# FeedbackMind AI - Environment Configuration Template
# Copy this file to .env and provide your actual API keys

# Server Configuration
PORT=5001
NODE_ENV=development

# Allowed CORS Origins (comma-separated URLs)
# In production, set to your frontend domain (e.g., https://feedbackmind.yourdomain.com)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Admin API Key (used to authorize sensitive maintenance/seed operations in production)
ADMIN_API_KEY=

# Groq AI Configuration
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Hindsight Cloud Long-Term Memory Configuration
# Documentation: https://docs.hindsight.vectorize.io/
HINDSIGHT_API_KEY=your_hindsight_api_key_here
HINDSIGHT_BANK_ID=feedbackmind-demo
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io

# Database Configuration (Persistent storage via Node.js native node:sqlite)
DATABASE_PATH=./feedbackmind.sqlite
